# Private access panel — Vercel env vars
# Set these in Vercel Dashboard > confession-access-panel-motherland > Settings > Environment Variables

SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role... (KEEP SECRET — server only)
ENCRYPTION_SECRET=base64-of-32-random-bytes (MUST be identical to the confession project)
ADMIN_PASSWORD=choose-a-long-strong-password-here (you set this in Vercel, used to unlock the panel)

# Generate the encryption secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
